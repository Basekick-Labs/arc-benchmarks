+// tsbs_dump_tdengine_queries decodes a TSBS TDengine query file (gob) and
+// prints one JSON object per query: {"label": ..., "sql": ...}.
+// Used to run the exact same query instances against Arc.
+package main
+
+import (
+	"bufio"
+	"encoding/gob"
+	"encoding/json"
+	"io"
+	"log"
+	"os"
+
+	"github.com/taosdata/tsbs/pkg/query"
+)
+
+func main() {
+	dec := gob.NewDecoder(bufio.NewReaderSize(os.Stdin, 1<<20))
+	enc := json.NewEncoder(os.Stdout)
+	for {
+		q := &query.TDengine{}
+		if err := dec.Decode(q); err == io.EOF {
+			return
+		} else if err != nil {
+			log.Fatal(err)
+		}
+		enc.Encode(map[string]string{"label": string(q.HumanLabel), "sql": string(q.SqlQuery)})
+	}
+}
